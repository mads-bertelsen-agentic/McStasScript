begin instrument:
  Creator: mcstas 3.7.14
  Source: tiny_scan.instr
  Parameters:  theta
  Trace_enabled: no
  Default_main: yes
  Embedded_runtime: yes
end instrument

begin simulation
Date: Wed Oct 28 13 51 2026
Ncount: 64
Numpoints: 3
Param: theta = -1, theta = 1
end simulation

begin data
type: multiarray_1d(3)
title: Scan of theta
xvars: theta
yvars: (spectrum_I,spectrum_ERR
xlabel: 'theta'
ylabel: 'Intensity'
xlimits: -1 1
filename: mccode.dat
variables: thetaspectrum_I spectrum_ERR
end data
